{
  // typecheck 用这一份：覆盖 src 与 tests，只检查不产出。
  // 构建走 tsconfig.build.json（只含 src、rootDir=src、落 dist）——
  // 两件事的 rootDir 要求相反，合在一份配置里必然有一头错。
  //
  // 与 dsh-memory 同一形态：依赖真装在 node_modules，类型就从那里解析，不用 paths
  // 指到相邻 checkout。类型来源必须与**运行时装的那版内核**一致；指到 checkout 会让
  // typecheck 通过、装版却按另一个版本的类型跑。
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "tests"]
}
